# ────────────────────────────────────────────────────────────────────────────
# 로컬 개발용 환경변수 본보기
#
# 이 파일을 .env.local 로 복사하고 값을 채우세요. (.env.local 은 저장소에
# 올라가지 않습니다)
#
#     cp .env.example .env.local
#
# 실제 배포(Vercel)는 이 파일을 쓰지 않습니다. Vercel > Project Settings >
# Environment Variables 에 따로 들어 있습니다.
# ────────────────────────────────────────────────────────────────────────────


# ── 필수 ────────────────────────────────────────────────────────────────────
# 이 둘이 없으면 `npm run build` 가 "Generating static pages" 단계에서 실패합니다.
# src/lib/supabase.ts 가 모듈을 불러오는 순간 클라이언트를 만드는데, 값이 비어
# 있으면 @supabase/ssr 이 "URL and API key are required" 로 예외를 냅니다.
# 빌드는 정적 페이지를 만들려고 이 모듈을 서버에서 한 번 실행하므로 거기서 터집니다.
# (컴파일·타입체크는 그 전에 이미 통과하므로, 이 실패는 코드 문제가 아닙니다)
#
# 두 값은 Supabase 대시보드 > Project Settings > API 에 있습니다.
# anon 키는 브라우저로 그대로 나가는 공개 키입니다 — service_role 키와 헷갈리지 마세요.
NEXT_PUBLIC_SUPABASE_URL=https://<프로젝트참조>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ── 선택: 푸시 알림 ─────────────────────────────────────────────────────────
# 비어 있어도 앱은 정상 동작하지만, [내 정보]에서 알림 스위치를 켤 때
# "푸시 설정이 아직 준비되지 않았습니다" 로 막힙니다 (src/lib/push.ts).
#
# 여기 들어가는 것은 VAPID 키 쌍 중 **공개 키**입니다. 짝이 되는 비밀 키는
# 이 파일이 아니라 Supabase Edge Function 비밀값으로 들어갑니다 (아래 참고).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=


# ── 선택: OAuth 되돌아올 주소 ───────────────────────────────────────────────
# 프록시 뒤에 있어서 x-forwarded-host 가 실제 도메인과 다를 때만 필요합니다.
# 로그인 후 되돌아올 수 있는 도메인을 하나 더 허용합니다
# (app/auth/callback/route.ts 의 resolveRedirectBase — 열린 리다이렉트 방지).
# 로컬 개발에서는 비워 두면 됩니다.
NEXT_PUBLIC_SITE_URL=


# ────────────────────────────────────────────────────────────────────────────
# 여기 두지 않는 값들 — 참고용
#
# ▸ SUPABASE_SERVICE_ROLE_KEY
#     모든 권한을 가진 키라 파일에 저장하지 않습니다.
#     scripts/cleanup-orphan-files.mjs 를 돌릴 때만 명령줄로 한 번 넘깁니다:
#       SUPABASE_SERVICE_ROLE_KEY=<키> node scripts/cleanup-orphan-files.mjs
#
# ▸ Edge Function(send-push) 비밀값
#     supabase/functions/send-push/index.ts 가 쓰는 값들로, 앱이 아니라
#     Supabase 쪽에 저장됩니다 (대시보드 > Edge Functions > Secrets):
#       VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, PUSH_QUIET_HOURS_ENABLED
#     SUPABASE_URL 과 SUPABASE_SERVICE_ROLE_KEY 는 Supabase 가 자동으로 넣어 줍니다.
# ────────────────────────────────────────────────────────────────────────────
